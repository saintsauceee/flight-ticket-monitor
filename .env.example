# Copy this file to .env and adjust. Everything here is optional:
# with no .env at all the app runs on simulated demo data.

# --- Live fares -------------------------------------------------------------
# Key for SerpApi's Google Flights API (https://serpapi.com/google-flights-api).
# When set, the app switches from demo data to real fares.
SERPAPI_KEY=

# Searches the app may spend per calendar month. Every search, scheduled check
# and "load fare details" counts. Match this to your SerpApi plan.
SERPAPI_MONTHLY_BUDGET=250

# Google country used for the search (affects which fares are offered).
# SERPAPI_GL=us

# Ask Google for the exact results a browser would show. More accurate, slower.
# SERPAPI_DEEP_SEARCH=false

# Force a data source regardless of the key: "mock" or "serpapi".
# FLIGHT_PROVIDER=mock

# --- Tracking ---------------------------------------------------------------
# Default hours between re-checks of a tracked trip (each trip can override it).
# Defaults: 24 with live fares, 6 with demo data.
# CHECK_INTERVAL_HOURS=24

# A drop of at least this many percent between two checks raises an alert.
# PRICE_DROP_ALERT_PCT=5

# Minutes a search result is reused before asking the provider again.
# Defaults: 60 with live fares, 10 with demo data.
# SEARCH_CACHE_MINUTES=60

# Set to false to stop automatic re-checks (manual "Check now" still works).
# SCHEDULER_ENABLED=true

# --- Server -----------------------------------------------------------------
# PORT=8787
# The app has no login, so it listens on this machine only by default.
# HOST=127.0.0.1
# DATABASE_PATH=data/flights.db
